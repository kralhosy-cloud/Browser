<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.calyra.browser">
    <!-- Minimal permissions — CAMERA/MIC only on user gesture via Gecko permission delegate -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Storage is isolated via app-private dir; READ_EXTERNAL_STORAGE only for explicit import -->
    <application
        android:name=".CalyraApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_calyra"
        android:label="Calyra"
        android:theme="@style/Theme.Calyra">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <!-- Isolated helper process for filter updates — crash does not kill renderer -->
        <service android:name=".helper.FilterUpdateService" android:isolatedProcess="false" android:exported="false"/>
    </application>
</manifest>
